    "sql": "SELECT \"t\".\"month\" AS \"month\", \"t\".\"total_amount\" AS \"total_amount\", CASE WHEN \"t\".\"prev_amount\" IS NULL OR \"t\".\"prev_amount\" = 0 THEN NULL ELSE ROUND((\"t\".\"total_amount\" - \"t\".\"prev_amount\") / \"t\".\"prev_amount\" * 100, 2) || '%' END AS \"growth_rate\" FROM (SELECT TO_CHAR(\"o\".\"order_date\", 'YYYY-MM') AS \"month\", SUM(\"o\".\"amount\") AS \"total_amount\", LAG(SUM(\"o\".\"amount\")) OVER (ORDER BY TO_CHAR(\"o\".\"order_date\", 'YYYY-MM')) AS \"prev_amount\" FROM \"public\".\"orders\" \"o\" WHERE \"o\".\"order_date\" >= DATE '2025-01-01' AND \"o\".\"order_date\" < DATE '2026-01-01' GROUP BY TO_CHAR(\"o\".\"order_date\", 'YYYY-MM')) \"t\" ORDER BY \"t\".\"month\" LIMIT 40",
