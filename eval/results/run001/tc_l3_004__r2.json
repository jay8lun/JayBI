    "sql": "WITH \"monthly\" AS (SELECT TO_CHAR(\"o\".\"order_date\", 'YYYY-MM') AS \"month\", SUM(\"o\".\"amount\") AS \"total_amount\" FROM \"public\".\"orders\" \"o\" WHERE \"o\".\"order_date\" >= DATE '2025-01-01' AND \"o\".\"order_date\" < DATE '2026-01-01' GROUP BY TO_CHAR(\"o\".\"order_date\", 'YYYY-MM')), \"monthly_lag\" AS (SELECT \"m\".\"month\" AS \"month\", \"m\".\"total_amount\" AS \"total_amount\", LAG(\"m\".\"total_amount\") OVER (ORDER BY \"m\".\"month\") AS \"prev_amount\" FROM \"monthly\" \"m\") SELECT \"ml\".\"month\" AS \"month\", \"ml\".\"total_amount\" AS \"total_amount\", ROUND((\"ml\".\"total_amount\" - \"ml\".\"prev_amount\") / NULLIF(\"ml\".\"prev_amount\", 0) * 100, 2)::text || '%' AS \"growth_rate\" FROM \"monthly_lag\" \"ml\" ORDER BY \"ml\".\"month\" LIMIT 40",
