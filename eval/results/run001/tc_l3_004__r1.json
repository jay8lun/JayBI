    "sql": "SELECT TO_CHAR(\"o\".\"order_date\", 'YYYY-MM') AS \"month\", ROUND(SUM(\"o\".\"amount\"), 2) AS \"total_amount\", ROUND((SUM(\"o\".\"amount\") - LAG(SUM(\"o\".\"amount\")) OVER (ORDER BY TO_CHAR(\"o\".\"order_date\", 'YYYY-MM'))) * 100.0 / NULLIF(LAG(SUM(\"o\".\"amount\")) OVER (ORDER BY TO_CHAR(\"o\".\"order_date\", 'YYYY-MM')), 0), 2) || '%' AS \"growth_rate\" FROM \"public\".\"orders\" \"o\" WHERE \"o\".\"order_date\" >= DATE '2025-01-01' AND \"o\".\"order_date\" < DATE '2026-01-01' GROUP BY TO_CHAR(\"o\".\"order_date\", 'YYYY-MM') ORDER BY \"month\" ASC LIMIT 40",
