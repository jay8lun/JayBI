    "sql": "WITH \"monthly_totals\" AS (\n    SELECT\n        TO_CHAR(\"o\".\"order_date\", 'YYYY-MM') AS \"month\",\n        SUM(\"o\".\"amount\") AS \"total_amount\"\n    FROM \"public\".\"orders\" \"o\"\n    WHERE \"o\".\"order_date\" >= DATE '2025-01-01'\n      AND \"o\".\"order_date\" < DATE '2026-01-01'\n    GROUP BY TO_CHAR(\"o\".\"order_date\", 'YYYY-MM')\n)\nSELECT\n    \"mt\".\"month\" AS \"month\",\n    \"mt\".\"total_amount\" AS \"total_amount\",\n    ROUND(\n        (\"mt\".\"total_amount\" - LAG(\"mt\".\"total_amount\") OVER (ORDER BY \"mt\".\"month\"))\n        / NULLIF(LAG(\"mt\".\"total_amount\") OVER (ORDER BY \"mt\".\"month\"), 0) * 100,\n        2\n    ) || '%' AS \"growth_rate\"\nFROM \"monthly_totals\" \"mt\"\nORDER BY \"mt\".\"month\" ASC\nLIMIT 40;",
    "columns": [
      "month",
      "total_amount",
      "growth_rate"
    ],
